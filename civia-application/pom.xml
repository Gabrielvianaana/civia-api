<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.fiap.civia</groupId>
        <artifactId>civia-api</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>civia-application</artifactId>
    <name>CIVIA - Application</name>
    <description>Camada BO (regras de negocio e casos de uso), DTOs (records) e excecoes de aplicacao.</description>

    <dependencies>
        <!-- optional=true: domain/infrastructure NAO chegam transitivamente a presentation -->
        <dependency>
            <groupId>br.com.fiap.civia</groupId>
            <artifactId>civia-infrastructure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>br.com.fiap.civia</groupId>
            <artifactId>civia-domain</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-fronteira-application</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <searchTransitive>true</searchTransitive>
                                    <excludes>
                                        <exclude>br.com.fiap.civia:civia-presentation</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-webmvc</exclude>
                                        <exclude>org.springframework.boot:spring-boot-starter-web</exclude>
                                    </excludes>
                                    <message>[DDD] application nao pode depender de presentation nem da camada web.</message>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
