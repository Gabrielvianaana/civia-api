@startuml
title CIVIA - BOs com metodos
' Gerado a partir do codigo-fonte Java (pasta civia-*/src/main/java).
!pragma layout smetana
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam dpi 150
hide empty members
top to bottom direction
class AtualizacaoDisponibilidadeBO <<Service>> {
  -atualizacaoDAO : AtualizacaoDisponibilidadeDAO
  -servicoDAO : ServicoDAO
  -usuarioDAO : UsuarioPainelDAO
  -clock : Clock
  +listar(servicoId) : List<AtualizacaoDisponibilidadeResponse>
  +buscar(id) : AtualizacaoDisponibilidadeResponse
  +registrar(r) : AtualizacaoDisponibilidadeResponse
  +corrigir(id, r) : AtualizacaoDisponibilidadeResponse
  +excluir(id) : void
}
class CargaInicialBO <<Service>> {
  -tipoDAO : TipoServicoDAO
  -perfilDAO : PerfilAtendidoDAO
  +carregarSeNecessario() : void
}
class ConsultaTotemBO <<Service>> {
  -consultaDAO : ConsultaTotemDAO
  -totemDAO : TotemDAO
  -tipoDAO : TipoServicoDAO
  -perfilDAO : PerfilAtendidoDAO
  -servicoDAO : ServicoDAO
  -clock : Clock
  -random : RandomGenerator
  +listar(totemId) : List<ConsultaTotemResponse>
  +buscar(id) : ConsultaTotemResponse
  +registrar(r) : ConsultaTotemResponse
  +atualizar(id, r) : ConsultaTotemResponse
  +registrarChegada(codigo) : ConsultaTotemResponse
  +excluir(id) : void
}
class DisponibilidadeBO <<Component>> {
  +{static} VALIDADE_ATUALIZACAO : Duration
  +{static} MINIMO_VAGAS_TEM_VAGA : int
  +calcular(servico, grade, ultimaAtualizacao, agora) : Disponibilidade
  +{static} faixaDeVagas(vagas) : StatusDisponibilidade
}
class HorarioBO <<Service>> {
  -horarioDAO : HorarioDAO
  -servicoDAO : ServicoDAO
  +listar(servicoId) : List<HorarioResponse>
  +buscar(servicoId, id) : HorarioResponse
  +cadastrar(servicoId, r) : HorarioResponse
  +atualizar(servicoId, id, r) : HorarioResponse
  +excluir(servicoId, id) : void
}
class MapaServicosBO <<Service>> {
  +{static} LIMITE_RESULTADOS : int
